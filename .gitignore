# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
apps/*/.next/
apps/*/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Turborepo
.turbo/

# Local "Save As" copies of design preview (use docs/mood-board.html instead)
Headball — Design Preview.html
Headball — Design Preview_files/

# Mockup screenshots / scratch images at root
/*.png
!public/**/*.png

# Supabase local
supabase/.temp/
supabase/.branches/

# IDE
.vscode/
.idea/

# Playwright
/playwright-report/
/test-results/
**/playwright-report/
**/test-results/

# Ralph runtime scratch
scripts/ralph/.last-branch
apps/*/scripts/ralph/.last-branch
.ralph/.last-branch

# Git worktree scratch dirs (used by parallel agent sessions)
.worktrees/

# Wikidata raw fetches (regeneratable via `bun run seed:fetch`)
/data/raw/

# Claude Code per-developer settings (skills/ are committed)
.claude/settings.local.json

# Supabase Studio scratch — auto-generated "Untitled query N.sql" snippets
/supabase/snippets/
