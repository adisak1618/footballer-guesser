# Headball / Multi-Game Platform — Environment Variables
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored. NEVER commit real values.

# -----------------------------------------------------------------------------
# Supabase — pick ONE of the three options below by uncommenting the right pair.
# -----------------------------------------------------------------------------

# Option A: LOCAL development (bunx supabase start)
# These values come from `bunx supabase status` after running `bunx supabase start`.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste output of `bunx supabase status` -> anon key>

# Option B: STAGING (Vercel preview env points here too)
# Get from Supabase Dashboard -> headball-staging project -> Settings -> API
# NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<staging-anon-key-jwt-format>

# Option C: PRODUCTION (Vercel production env points here)
# Currently NOT set up yet — will be created in a future v2 milestone after
# Insider proves out on staging (per T-5.C from eng review).
# NEXT_PUBLIC_SUPABASE_URL=https://<prod-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<prod-anon-key>

# -----------------------------------------------------------------------------
# DB password is NEVER added here. It belongs only:
#   - in your password manager
#   - inline on supabase CLI invocations: SUPABASE_DB_PASSWORD='...' bunx supabase ...
# -----------------------------------------------------------------------------
