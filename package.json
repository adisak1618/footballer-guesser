{
  "name": "board-game",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.1.29",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@social-hub/headball",
    "dev:all": "turbo run dev --parallel",
    "dev:hub": "turbo run dev --filter=@social-hub/hub",
    "dev:insider": "turbo run dev --filter=@social-hub/insider",
    "build": "turbo run build --filter=@social-hub/headball",
    "build:all": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "seed:fetch": "bun run scripts/fetch-wikidata.ts",
    "seed:build": "bun run scripts/build-seed.ts",
    "seed:sql": "bun run scripts/seed-to-sql.ts",
    "seed:all": "bun run seed:fetch && bun run seed:build && bun run seed:sql"
  },
  "devDependencies": {
    "@types/node": "^20",
    "supabase": "^2.95.6",
    "turbo": "^2.9.10",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
